# Copy this file to .env.local and fill in your own key.
# .env.local is git-ignored, so your real key is never committed or pushed.

# Create a prototype key at https://build.nvidia.com, then paste it here.
NVIDIA_API_KEY=your-key-here

# A fast chat model with a free NVIDIA NIM prototype endpoint.
NVIDIA_MODEL=meta/llama-3.2-3b-instruct
