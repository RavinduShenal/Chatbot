# Copy this file to .env.local and fill in your own key.
# .env.local is git-ignored, so your real key is never committed or pushed.

# Create a key at https://openrouter.ai/keys, then paste it here.
OPENROUTER_API_KEY=your-key-here

# OpenRouter automatically selects an available free model.
OPENROUTER_MODEL=openrouter/free
