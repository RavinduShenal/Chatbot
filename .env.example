# Copy this file to .env.local and fill in your own key.
# .env.local is git-ignored, so your real key is never committed or pushed.

# Get a key from https://aistudio.google.com/app/apikey, then paste it here.
GEMINI_API_KEY=your-key-here

# A stable, fast Gemini model for chat.
GEMINI_MODEL=gemini-2.5-flash
