# Copy this file to .env.local and fill in your own key.
# .env.local is git-ignored, so your real key is never committed or pushed.

# Get a free key (no credit card needed) from https://ai.google.dev -> "Get API Key"
GEMINI_API_KEY=your-key-here

# Which model to use (gemini-2.5-flash is the free-tier default, fast and cheap)
GEMINI_MODEL=gemini-3-flash
